root = "."
tmp_dir = "tmp"

# run `{{.PackageManager}} run dev` in web/app alongside air
[build]
  pre_cmd = ["templ generate"]
  cmd = "go build -o ./tmp/main ./cmd/{{.Name}}"
  bin = "./tmp/main"
  args_bin = ["-dev"]
  include_ext = ["go", "templ"]
  exclude_dir = ["tmp", "web/app", "web/static"]
  exclude_regex = ["_test\\.go$", "_templ\\.go$"]
  delay = 500
  stop_on_error = true

[misc]
  clean_on_exit = true
