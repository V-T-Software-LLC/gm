# Copy this file to .env and fill in the values. The Makefile loads .env, so
# make dev, make run, and make db pick these up. When running bin/{{.Name}}
# directly, set these in the environment yourself.

# Postgres connection string. The server stores users here, and make db
# applies internal/db/schema.sql to it.
# postgres://user:password@host:port/database?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/{{.Name}}?sslmode=disable

# Redis connection string. The server stores sessions here.
# redis://[:password@]host:port/db
REDIS_URL=redis://localhost:6379/0
