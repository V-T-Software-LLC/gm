package views

type SignUpData struct {
	FirstName string
	LastName  string
	Email     string
	Error     string
}

type SignInData struct {
	Email string
	Error string
}

templ SignUp() {
	@Layout("Sign up") {
		<main class="mx-auto max-w-sm p-8">
			<h1 class="text-3xl font-bold">Sign up</h1>
			@SignUpForm(SignUpData{})
			<p class="mt-4 text-sm">Already have an account? <a href="/signin" class="text-blue-600 hover:underline">Sign in</a></p>
		</main>
	}
}

templ SignUpForm(f SignUpData) {
	<form hx-post="/signup" hx-swap="outerHTML" class="mt-6 flex flex-col gap-4">
		@formError(f.Error)
		@field("First name", "first_name", "text", f.FirstName)
		@field("Last name", "last_name", "text", f.LastName)
		@field("Email", "email", "email", f.Email)
		@field("Password", "password", "password", "")
		@submit("Sign up")
	</form>
}

templ SignIn() {
	@Layout("Sign in") {
		<main class="mx-auto max-w-sm p-8">
			<h1 class="text-3xl font-bold">Sign in</h1>
			@SignInForm(SignInData{})
			<p class="mt-4 text-sm">Need an account? <a href="/signup" class="text-blue-600 hover:underline">Sign up</a></p>
		</main>
	}
}

templ SignInForm(f SignInData) {
	<form hx-post="/signin" hx-swap="outerHTML" class="mt-6 flex flex-col gap-4">
		@formError(f.Error)
		@field("Email", "email", "email", f.Email)
		@field("Password", "password", "password", "")
		@submit("Sign in")
	</form>
}

templ formError(msg string) {
	if msg != "" {
		<p class="rounded bg-red-50 p-3 text-sm text-red-700">{ msg }</p>
	}
}

templ field(label, name, typ, value string) {
	<label class="flex flex-col gap-1 text-sm font-medium">
		{ label }
		<input
			type={ typ }
			name={ name }
			value={ value }
			required
			class="rounded border border-gray-300 px-3 py-2 font-normal"
		/>
	</label>
}

templ submit(label string) {
	<button type="submit" class="rounded bg-blue-600 px-4 py-2 text-white hover:bg-blue-700">{ label }</button>
}
