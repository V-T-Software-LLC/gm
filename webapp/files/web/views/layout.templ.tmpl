package views

// Dev loads scripts from the vite dev server instead of web/static.
var Dev bool

const viteURL = "http://localhost:5173"

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js" integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg" crossorigin="anonymous"></script>
			if Dev {
				<link rel="stylesheet" href={ viteURL + "/src/app.css" }/>
				<script type="module" src={ viteURL + "/@vite/client" }></script>
				<script type="module" src={ viteURL + "/src/main.{{.Lang}}" }></script>
			} else {
				<link rel="stylesheet" href="/static/app.css"/>
				<script type="module" src="/static/main.js"></script>
			}
		</head>
		<body class="bg-gray-50 text-gray-900">
			{ children... }
		</body>
	</html>
}
