include(DownloadGoogleTest)
include(CMakeParseArguments)
include(GoogleTest)

function({{.Name}}_add_test)
    cmake_parse_arguments({{.Name}}_C_TEST
        ""
        "NAME"
        "SRCS;COPTS;DEPS"
        ${ARGN}
    )
    set(_NAME "{{.Name}}_${{{.Name}}_C_TEST_NAME}")
    add_executable("${_NAME}" "")
    target_sources(${_NAME} PRIVATE ${{{.Name}}_C_TEST_SRCS})
    target_compile_options(${_NAME}
        PRIVATE ${{{.Name}}_C_TEST_COPTS}
    )
    target_compile_options(${_NAME}
        PRIVATE "-g"
    )
    target_include_directories(${_NAME} PRIVATE ${CMAKE_SOURCE_DIR})
    target_link_libraries(${_NAME} PUBLIC ${CX_C_TEST_DEPS})
    target_link_libraries(${_NAME}
        PUBLIC
        GTest::gtest_main
        GTest::gmock_main
    )
    gtest_discover_tests(${_NAME}
        DISCOVERY_MODE PRE_TEST)
endfunction()
